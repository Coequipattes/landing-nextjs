# =============================================================================
# Variables PUBLIQUES — exposées au bundle client (préfixe VITE_, inlinées par
# Vite au build). Ne JAMAIS y mettre de secret. Lues via import.meta.env.
# =============================================================================

# Site
VITE_SITE_URL=https://example.com

# Contact (public — affiché côté client)
VITE_CONTACT_EMAIL=contact@example.com

# =============================================================================
# Variables SERVEUR — secrets, jamais exposées au client. Lues via process.env
# à l'intérieur des server functions / server routes uniquement.
# =============================================================================

# Admin auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Générer avec : node -e "require('crypto').createHash('sha256').update('votre-mdp').digest('hex')"
AUTH_SECRET=
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Resend (envoi d'emails)
RESEND_API_KEY=
# Créer une clé sur https://resend.com/api-keys
CONTACT_EMAIL_FROM=Co'équi'pattes <noreply@example.com>
CONTACT_EMAIL_TO=contact@example.com

# Google Places (avis clients)
GOOGLE_PLACES_API_KEY=
# Créer une clé sur https://console.cloud.google.com
GOOGLE_PLACE_ID=
# Trouver l'ID sur https://developers.google.com/maps/documentation/places/web-service/place-id

# Cron (rafraîchissement automatique des avis)
CRON_SECRET=
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
